# Copy to .env for local overrides. Never commit .env or real secrets.

# Logging: Trace, Debug, Information, Warning, Error, Critical
SIMPULSE_LOG_LEVEL=Information
# File logs (WinExe-friendly). Default: %LOCALAPPDATA%\SimPulse\logs or user-profile/SimPulse/logs
# SIMPULSE_LOG_DIR=
# SIMPULSE_LOG_FILE=0

# Windows tray pairing UX (default when interactive). Set 0 to use console PIN logs.
# SIMPULSE_BRIDGE_TRAY=0
#
# Documents intent to debug with a console. Does not change OutputType at build time.
# Use: dotnet run --project apps/windows-bridge/SimPulse.Bridge --property:OutputType=Exe
# SIMPULSE_BRIDGE_CONSOLE=1

# Bridge bind address. Default 127.0.0.1 (loopback).
SIMPULSE_BRIDGE_HOST=127.0.0.1
SIMPULSE_BRIDGE_PORT=8742
# TLS is enabled by default. Only 0, false, or off selects cleartext, which is loopback-only.
SIMPULSE_BRIDGE_TLS=1
# Optional existing PFX and password. Never commit either value or the certificate.
# SIMPULSE_BRIDGE_CERT_PATH=
# SIMPULSE_BRIDGE_CERT_PASSWORD=
# Generated certificate directory. Default: %LOCALAPPDATA%\SimPulse\certs
# SIMPULSE_BRIDGE_CERT_DIR=

# Path to trusted-device store (JSON). Keep outside source control.
SIMPULSE_TRUSTED_DEVICES_PATH=./trusted-devices.json

# Optional fixture replay instead of a live simulator.
SIMPULSE_FIXTURE_PATH=

# Apple / App Store Connect (used only on macOS CI later)
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_KEY_ID=
# APP_STORE_CONNECT_KEY_PATH=
