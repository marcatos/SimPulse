# Copy to .env for local overrides. Never commit .env or real secrets.

# Logging: Trace, Debug, Information, Warning, Error, Critical
SIMPULSE_LOG_LEVEL=Information

# Bridge bind address. Default 127.0.0.1 (loopback). Set 0.0.0.0 to opt in to all interfaces.
SIMPULSE_BRIDGE_HOST=127.0.0.1
SIMPULSE_BRIDGE_PORT=8742

# Path to trusted-device store (JSON). Keep outside source control.
SIMPULSE_TRUSTED_DEVICES_PATH=./trusted-devices.json

# Optional fixture replay instead of a live simulator.
SIMPULSE_FIXTURE_PATH=

# Apple / App Store Connect (used only on macOS CI later)
# APP_STORE_CONNECT_ISSUER_ID=
# APP_STORE_CONNECT_KEY_ID=
# APP_STORE_CONNECT_KEY_PATH=
