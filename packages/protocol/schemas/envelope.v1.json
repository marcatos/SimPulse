{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpulse.local/protocol/v1/envelope.json",
  "title": "SimPulse protocol envelope v1",
  "type": "object",
  "required": ["protocolVersion", "type", "messageId", "sentAtUtc", "payload"],
  "additionalProperties": true,
  "properties": {
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "type": { "type": "string", "minLength": 1 },
    "messageId": { "type": "string", "minLength": 1 },
    "sentAtUtc": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}
